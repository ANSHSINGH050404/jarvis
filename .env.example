# Environment Configuration
NODE_ENV=development

# Gateway Server
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3000
GATEWAY_WS_PORT=3001

# Security
API_KEY=your_api_key_here_change_in_production

# LLM Provider (for Week 2)
GEMINI_API_KEY=your_gemini_api_key
