{
  "name": "@jarvis/root",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "dev:gateway": "bun run --watch packages/gateway/src/server.ts",
    "dev:test-client": "bun run scripts/test-client.ts",
    "start:telegram": "bun run packages/telegram-client/src/index.ts",
    "build": "bun run scripts/build.ts",
    "clean": "rm -rf packages/*/dist node_modules packages/*/node_modules",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.0.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "zod": "^3.22.4"
  }
}
