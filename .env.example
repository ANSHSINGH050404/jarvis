# Database (for Week 4)
DATABASE_PATH=./data/jarvis.db

# Channels (for Week 5)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# Logging
LOG_LEVEL=debug
